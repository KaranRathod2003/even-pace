# Neon → your project → Connect → copy the connection string
DATABASE_URL=

# Optional: password-protect the deployed site (leave empty locally)
APP_PASSWORD=

# Push notifications: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:flow@example.com

# Any long random string; the scheduler sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
